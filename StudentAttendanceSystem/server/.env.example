# ── Environment & Port ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── PostgreSQL Database Connection (Cloud Aiven / Supabase / Neon / Local) ───
DATABASE_URL=postgres://<username>:<password>@<host>:<port>/<database>?sslmode=require

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── Microservices & Cross-Origin Configuration ────────────────────────────────
# URL where Python Flask Face Recognition microservice is running
FACE_API_URL=http://localhost:5001/api

# Allowed Frontend URL(s) for CORS (supports comma-separated list for multiple domains)
# Example: https://attendance.yourdomain.com,https://staging.yourdomain.com
FRONTEND_URL=http://localhost:5173

# ── Optional: HuggingFace Token for Face Recognition Space ───────────────────
# If set, provides authenticated rate limits for nitishsaini44/baffaloL_model
HF_TOKEN=your_optional_hf_token

# ── Administrator Account Initial Seed (One-time setup) ──────────────────────
# Run: npm run seed:admin
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@institution.edu
ADMIN_PASSWORD=your_strong_password_minimum_8_chars
