# ── Docker Compose Environment Configuration ─────────────────────────────────
# Copy this file to .env before running `docker compose up --build`

# PostgreSQL Connection String (Aiven / Supabase / Neon / Managed Cloud DB)
DATABASE_URL=postgres://<username>:<password>@<host>:<port>/<database>?sslmode=require

# Authentication
JWT_SECRET=super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Microservice & Network Ports
SERVER_PORT=5000
FACE_API_PORT=5001
CLIENT_PORT=80

# Cross-Origin URL (Frontend domain)
FRONTEND_URL=http://localhost,http://localhost:80,http://localhost:5173

# Frontend build-time API base URL (accessible by user browser)
VITE_API_URL=http://localhost:5000/api

# Optional: HuggingFace Token for rate-limit protection
HF_TOKEN=
